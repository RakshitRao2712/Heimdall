[Unit]
Description=Heimdall API
After=network-online.target
Wants=network-online.target

[Service]
User=heimdall
Group=heimdall
WorkingDirectory=/opt/heimdall
EnvironmentFile=/etc/heimdall/backend.env
ExecStart=/usr/bin/java -Xms64m -Xmx384m -XX:MaxMetaspaceSize=192m -jar /opt/heimdall/heimdall.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/heimdall

[Install]
WantedBy=multi-user.target
