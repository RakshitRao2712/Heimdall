# Copy to backend/.env.local (or the running backend folder). Never commit real keys.
RESEND_API_KEY=
HEIMDALL_MAIL_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HEIMDALL_GOOGLE_REDIRECT_URI=http://127.0.0.1:5174/api/auth/google/callback
HEIMDALL_FRONTEND_URL=http://127.0.0.1:5174

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server-side Website Copyright discovery provider
# Brave Search keys are supplied per user in Website Copyright; no shared server key.

# Server-only secret for signed Razorpay notifications.
RAZORPAY_WEBHOOK_SECRET=
# Operator-managed complimentary access, comma-separated verified account emails.
HEIMDALL_PREMIUM_EMAILS=
